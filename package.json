{
  "name": "mcp-harness",
  "version": "0.1.0",
  "description": "In-memory testing toolkit for MCP servers in TypeScript — supertest for MCP",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./assertions": {
      "import": {
        "types": "./dist/assertions.d.ts",
        "default": "./dist/assertions.js"
      },
      "require": {
        "types": "./dist/assertions.d.cts",
        "default": "./dist/assertions.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "harness",
    "test-toolkit",
    "in-memory",
    "typescript"
  ],
  "author": "Gabriele Partiti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabry-ts/mcp-harness.git"
  },
  "homepage": "https://github.com/gabry-ts/mcp-harness#readme",
  "bugs": {
    "url": "https://github.com/gabry-ts/mcp-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^25.3.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^4.3.6"
  }
}
